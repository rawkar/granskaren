# Modeller. Driften går via sessionen (granskaren pass, /dagens), aldrig via API. Modellnamnen gäller agentdefinitionerna i .claude/agents.
TILLAT_API=false              # true tillåter API-klienten för ett medvetet undantag; då krävs också ANTHROPIC_API_KEY i miljön
MODELLVAG=session             # session är enda vägen i driften
MODEL_ANALYS=claude-opus-5-5
MODEL_SNABB=claude-haiku-4-5-20251001   # alltid fullständigt namn, aldrig alias
MODEL_DISCOVER=claude-opus-5-5   # webbsökningen i discover, tom = samma som MODEL_ANALYS
MAX_KOSTNAD_PER_MANAD=100     # USD per kalendermånad enligt kostnadsloggen, 0 = inget tak. Körningar avbryts när det nås.

# Mejlets längd och den fasta meningen om fler fynd
MEJL_ORDMAL=150               # ordmål för brödtexten
MEJL_MAX_ORD=190              # grindens övre ordgräns
MEJL_FLER_FYND=true           # programmet lägger in en fast mening ur prompts/fler-fynd.md före erbjudandet när fler bekräftade fynd finns
CACHE_TTL=5m                  # 5m eller 1h, livslängd på cachen för systemprompten, 1h i förslaget
ANDRINGAR_FRAN=               # dagen ändringarna slogs på, YYYY-MM-DD. Styr veckorapportens jämförelse med Opus-perioden och kvalitetsvakten. Tom = av

# Mejl. Skickas med SMTP av granskaren send; lösenordet är ett applösenord.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

AVSANDARE_NAMN=Rawaz Karim
AVSANDARE_EPOST=
AVSANDARE_TELEFON=            # visas i signaturen på egen rad före webbadressen när det är ifyllt
AVSANDARE_SAJT=https://rkkommunikation.se
BOKNINGSLANK=
AMNESMALL=Några förslag för {domän}   # {domän} eller {namn}. Över 60 tecken används namnet.

SANDLAGE=granska          # granska | auto. granska: alla mejl till granskningskön, Rawaz godkänner vart och ett med granskaren review
SAND_PAUSAD=false         # true pausar alla utskick, köade mejl ligger kvar
TORRKORNING=false         # true skickar aldrig något på riktigt utan skriver .eml-filer i data/torrkorning/
MAX_MEJL_PER_DAG=20
SANDFONSTER_START=08:30
SANDFONSTER_SLUT=17:00
MIN_SAKERHET_AUTO=0.7      # används bara i läget auto
UPPFOLJNING_AKTIV=false
UPPFOLJNING_EFTER_ARBETSDAGAR=7

# Hämtning
# Paus mellan mejl i minuter (slumpas) och hur många kandidater discover tar fram per segment
PAUS_MIN_MINUTER=8
PAUS_MAX_MINUTER=30
DISCOVER_ANTAL=10

MAX_SIDOR_PER_SAJT=8
PAUS_MELLAN_SIDOR_MS=2000
