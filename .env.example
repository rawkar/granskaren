# Anthropic. Kontrollera aktuella modellnamn på https://platform.claude.com/docs/en/about-claude/models
ANTHROPIC_API_KEY=
MODEL_ANALYS=claude-opus-5-5
MODEL_SNABB=claude-haiku-4-5
MODEL_DISCOVER=claude-opus-5-5   # webbsökningen i discover, tom = samma som MODEL_ANALYS
MAX_KOSTNAD_PER_MANAD=100     # USD per kalendermånad enligt kostnadsloggen, 0 = inget tak. Körningar avbryts när det nås.

# Ändringar som prövas för lägre kostnad. Standardvärdena ger samma beteende som tidigare.
ANALYS_MAX_FYND=6             # högst så många fynd per sajt, 4 i förslaget
ANALYS_KORT=false             # true slår ihop observation, insikt och rotorsak till ett fält på högst två meningar
UPPTRAPPNING=false            # true kör analysen om på MODEL_UPPTRAPPNING när huvudinsikt saknas, inget bekräftat fynd har djup 3 eller färre än tre fynd bekräftas
MODEL_UPPTRAPPNING=claude-opus-5-5
MEJL_ORDMAL=0                 # ordmål för brödtexten som skickas till modellen, 0 = promptens eget, 190 i förslaget
MEJL_MAX_ORD=220              # grindens övre ordgräns, 210 i förslaget
MEJL_FLER_FYND=false          # true lägger till en mening före erbjudandet om att Rawaz såg fler saker, bara när fler bekräftade fynd finns
CACHE_TTL=5m                  # 5m eller 1h, livslängd på cachen för systemprompten, 1h i förslaget
ANDRINGAR_FRAN=               # dagen ändringarna slogs på, YYYY-MM-DD. Styr veckorapportens jämförelse med Opus-perioden och kvalitetsvakten. Tom = av

# Mejl (används från fas 3 och 4)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
IMAP_HOST=
IMAP_PORT=993

AVSANDARE_NAMN=Rawaz Karim
AVSANDARE_EPOST=
AVSANDARE_TELEFON=
AVSANDARE_SAJT=https://rkkommunikation.se
BOKNINGSLANK=
AMNESMALL=Några förslag för {domän}   # {domän} eller {namn}. Över 60 tecken används namnet.

SANDLAGE=granska          # granska | auto
RUN_PAUSAD=false          # true pausar den schemalagda API-körningen, den dag passet körs med /dagens
TORRKORNING=true          # true skickar aldrig något på riktigt
MAX_MEJL_PER_DAG=8
SANDFONSTER_START=08:30
SANDFONSTER_SLUT=15:30
MIN_SAKERHET_AUTO=0.85
UPPFOLJNING_AKTIV=false
UPPFOLJNING_EFTER_ARBETSDAGAR=7

# Hämtning
# Paus mellan mejl i minuter (slumpas) och hur många nya prospekt run letar upp när kön är tom
PAUS_MIN_MINUTER=4
PAUS_MAX_MINUTER=15
DISCOVER_ANTAL=10

MAX_SIDOR_PER_SAJT=8
PAUS_MELLAN_SIDOR_MS=2000
